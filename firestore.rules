rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NEXEED（@nexeed-consulting.com）とBeaconsulting（@beaconsulting.jp）のGoogleアカウントでログインした人だけが読み書きできる
    function staff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@(nexeed-consulting[.]com|beaconsulting[.]jp)$');
    }
    match /{document=**} {
      allow read, write: if staff();
    }
  }
}
